# Feature flags
BANK_SERVICE_AUTH_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET
APP_ENABLE_FEATURE_KYC=true
APP_ENABLE_FEATURE_CHATBOT=false
APP_ENABLE_FEATURE_LOANS=false

# Safe baseline backends. Advanced backends require their corresponding model
# files and optional runtime packages.
APP_FACE_BACKEND=simple
APP_LIVENESS_BACKEND=simple
APP_OCR_BACKEND=simple
APP_DOC_BACKEND=simple
APP_DOC_PORTRAIT_MODE=auto
APP_PORTRAIT_BACKEND=simple

# Thresholds
APP_FACE_THRESHOLD=0.85
APP_LIVE_THRESHOLD=0.80
APP_OCR_THRESHOLD=0.80
APP_DOC_THRESHOLD=0.80
APP_ADDRESS_THRESHOLD=0.75

# Calibration logging is off by default for local development.
APP_CALIBRATION_LOG=false
APP_CALIBRATION_DIR=./calib
# APP_INSTANCE_ID=dev-ml-01

# Optional local model paths. Keep model binaries out of Git until provenance
# and distribution are decided.
